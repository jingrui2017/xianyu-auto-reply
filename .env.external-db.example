# 复制为 .env.external-db 后在本机填写。不要提交真实口令，也不要把 CA 私钥放进这个文件。
# 启动:
#   docker compose --env-file .env.external-db -f docker-compose.external-db.yml up -d --build

# 只读挂载的 CA 证书。示例路径是本机证书文件，不是私钥。
XIANYU_CA_FILE=/Users/jerry/.config/xianyu-infra/ca.crt

# 公网地址。证书 SAN 含该 IP 时直接填写 IP；证书签给域名时填写域名，或同时设置下方 SERVER_HOSTNAME。
MYSQL_HOST=your-mysql-public-ip-or-hostname
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=xianyu_data
MYSQL_SSL_SERVER_HOSTNAME=

REDIS_HOST=your-redis-public-ip-or-hostname
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_SSL_SERVER_HOSTNAME=

# 留空则首次启动把随机管理员口令写入容器内 /app/backups/admin-initial-password.txt。日志只打印路径。
ADMIN_INITIAL_PASSWORD=

# 16GiB Mac 上的连接池上限。按云数据库 max_connections 再调，不要超过数据库允许的连接数。
BACKEND_DB_POOL_SIZE=20
BACKEND_DB_MAX_OVERFLOW=10
WEBSOCKET_DB_POOL_SIZE=30
WEBSOCKET_DB_MAX_OVERFLOW=10
SCHEDULER_DB_POOL_SIZE=10
SCHEDULER_DB_MAX_OVERFLOW=5
REDIS_POOL_SIZE=50

FRONTEND_PORT=9000
BACKEND_WEB_PORT=8089
WEBSOCKET_PORT=8090
SCHEDULER_PORT=8091
